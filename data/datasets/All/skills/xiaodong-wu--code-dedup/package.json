{
  "name": "code-dedup",
  "version": "2.0.0",
  "description": "Comprehensive code analysis for duplicate detection, dead code elimination, and structure optimization",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "code-dedup": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "analyze": "node src/cli.js analyze",
    "check-dup": "node src/cli.js check-dup",
    "check-dead": "node src/cli.js check-dead",
    "check-struct": "node src/cli.js check-struct",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "code-deduplication",
    "dead-code-detection",
    "code-analysis",
    "code-quality",
    "refactoring",
    "minhash",
    "lsh",
    "ast",
    "static-analysis",
    "duplicate-detection",
    "code-metrics",
    "complexity",
    "ai-agent",
    "skills"
  ],
  "author": "xiaodong-wu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaodong-wu/code-dedup-skills.git"
  },
  "bugs": {
    "url": "https://github.com/xiaodong-wu/code-dedup-skills/issues"
  },
  "homepage": "https://github.com/xiaodong-wu/code-dedup-skills#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "glob": "^10.3.10",
    "tree-sitter": "^0.21.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "tree-sitter-python": "^0.21.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
